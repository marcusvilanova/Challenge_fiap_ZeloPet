# Copie para .env OU exporte as variáveis no terminal. NUNCA versione o .env.
# Nenhuma variável é obrigatória: sem nada configurado o Zelo roda com o motor local e dados de demonstração.

# --- IA generativa (opcional) --------------------------------------------------------------
# Chave da API da Anthropic. Ativa a camada de LLM (extração de sintomas + reescrita validada).
ANTHROPIC_API_KEY=
# auto = usa o Claude se houver chave; local = força o motor local mesmo com chave
ZELO_LLM_PROVIDER=auto
# Modelo. Padrão: claude-opus-5-5. Para menor latência/custo: claude-haiku-5-5
ZELO_LLM_MODEL=claude-opus-5-5
# ZELO_LLM_BASE_URL=https://api.anthropic.com

# --- Visão computacional ---------------------------------------------------------------------
ZELO_VISION_URL=http://localhost:8001

# --- Dados de demonstração (DESLIGADOS por padrão; o run-local.ps1 liga só localmente) ------
ZELO_SEED_DEMO=false
ZELO_DEMO_PASSWORD=

# --- Banco de dados ----------------------------------------------------------------------------
# Padrão: H2 em arquivo (backend/data/). Para outro banco, defina as três:
# SPRING_DATASOURCE_URL=jdbc:...
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# --- Implantação ----------------------------------------------------------------------------------
# true quando servido por HTTPS (cookie de sessão com atributo Secure)
ZELO_COOKIE_SECURE=false
PORT=8080
